# ── jmyic-server ────────────────────────────────────────────────────────────
# Copy to .env for local dev; set the same keys as Railway variables in prod.

PORT=8080
NODE_ENV=development

# Comma-separated web origins allowed to connect (no trailing slash).
# Unset in production = https://jmyic-live.web.app + https://jmyic-live.firebaseapp.com
ALLOWED_ORIGINS=http://localhost:3000

# Sign/verify operator JWTs. MUST be a long random string in production.
JWT_SECRET=dev-insecure-secret-change-me

# Operator password. In production set OPERATOR_PASSWORD_HASH (bcrypt) — generate
# it with `npm run hash -- 'your password'`. OPERATOR_PASSWORD is a dev-only
# plaintext fallback.
OPERATOR_PASSWORD=letmein
# OPERATOR_PASSWORD_HASH=$2a$10$....
OPERATOR_JWT_TTL=12h

# Optional: also require a key on the big-screen URL (/audience?key=…).
# Leave unset for a frictionless display; the display view already hides the
# guest's answer and every phone number either way.
# DISPLAY_KEY=

# Firebase project whose sign-ins the /play phones use. Verifying a phone's ID
# token only needs the project id — no service account. Required in production.
# Leave unset locally to accept any non-empty token as the uid (dev only).
# FIREBASE_PROJECT_ID=jmyic-live
# Optional alternative: base64 of a service-account JSON for the same project.
# FIREBASE_SERVICE_ACCOUNT_B64=

# Optional Redis for crash recovery (state survives a server restart mid-show).
# REDIS_URL=redis://default:password@host:6379
SNAPSHOT_INTERVAL_MS=1000
