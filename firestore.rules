rules_version = '2';

// NOTE: These mirror the permissive access model the app has always used
// (same as database.rules.json). The operator panel is gated by a client-side
// password only, so there is no server-side identity to check against.
// Scoped to the collections the app actually uses, so an unknown path is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // Question pool — read by all screens, written by the operator's CSV upload.
    match /questions/{docId} {
      allow read, write: if true;
    }

    // Play-along player profiles, keyed by Firebase Auth uid.
    // Needs list access: PlayAlongPanel, LeaderboardModal, the data export and
    // the duplicate-phone check all query this collection, not single docs.
    match /playAlongUsers/{uid} {
      allow read, write: if true;
    }

    // Legacy play-along answers. Live answers are in Realtime Database
    // (playAlong/answers/{questionNumber}/{uid}); nothing writes here any more.
    // The rule stays because resetPlayAlongData() still lists and deletes this
    // collection — it needs access to the parent docs, not just /responses,
    // or "Reset Game Only" fails with permission-denied before it resets anything.
    match /playAlongAnswers/{questionId} {
      allow read, write: if true;

      match /responses/{responseId} {
        allow read, write: if true;
      }
    }
  }
}
