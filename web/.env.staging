# Staging — NOTE: there is no separate staging Firebase project yet.
# This points at the SAME jmyic-live project as production, so builds made
# with it share production data. Create a second Firebase project and swap
# these values if you need real isolation.

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBbxHp7vJovi69j5lr-F_3DFbRm3A6ORGY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jmyic-live.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jmyic-live
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jmyic-live.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=657959492817
NEXT_PUBLIC_FIREBASE_APP_ID=1:657959492817:web:05465029606d0aac79b9f0

# Environment Label
NEXT_PUBLIC_ENVIRONMENT=staging


# The game server's public URL (the Railway server service). Inlined at BUILD time.
# Set it as a Railway variable on the web service, e.g.
#   NEXT_PUBLIC_WS_URL=https://jmyic-server-production.up.railway.app
# The operator password now lives on the server (OPERATOR_PASSWORD_HASH there).
